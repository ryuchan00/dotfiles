[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
[ -f ~/.zshrc.base ] && source ~/.zshrc.base

export PATH="/usr/local/opt/mysql@5.6/bin:$PATH"
export HISTFILE=~/.zsh_history

if [ -x "`which go`" ]; then
  export GOPATH=$HOME/go
  export PATH="$GOPATH/bin:$PATH"
fi
export PATH="$HOME/.local/bin:$PATH"
alias rubymine='/mnt/c/Program\ Files/JetBrains/RubyMine\ 2022.1/bin/rubymine64.exe'

fpath=($HOME/.zsh/anyframe(N-/) $fpath)
autoload -Uz anyframe-init
anyframe-init

eval "$(starship init zsh)"

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

# git logの文字化けを防ぐ
export LESSCHARSET=utf-8
export LANG=C.UTF-8

if [ -e '/home/yamakawa00/.env' ]; then
  source '/home/yamakawa00/.env' # 秘匿しなきゃいけないじょうほうはここ
fi
export DISPLAY=$(cat /etc/resolv.conf | grep nameserver | awk '{print $2}'):0.0

function open() {
  cmd.exe /c start $(wslpath -w $1) > /dev/null 2>&1
}
alias say='cmd.exe /c %USERPROFILE%/say'

# Windows 側のユーザーホーム。powershell.exe だとプロファイルが読み込まれて
# 起動が遅く、PSReadLine のエラーが zsh の画面に混ざるので cmd.exe を使う
WIN_USERPROFILE=$(cmd.exe /c 'echo %USERPROFILE%' 2>/dev/null | tr -d '\r')
export WIN_USERHOME=$(wslpath -u "$WIN_USERPROFILE")
export WIN_USERNAME=${WIN_USERHOME:t}
unset WIN_USERPROFILE

if command -v tmux &>/dev/null && [ -z "$TMUX" ]; then
  tmux attach-session -t default 2>/dev/null || tmux new-session -s default
fi
