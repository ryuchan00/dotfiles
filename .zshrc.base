#LANG=en_US.UTF-8 vcs_info
#PROMPT="%{$fg[magenta]%}[%T]%{$reset_color%} %{$fg_bold[blue]%}%d %{$fg[red]%}($(rbenv version-name)) %{$fg[green]%}${vcs_info_msg_0_}
#%{$fg_bold[blue]%}$%{$reset_color%} "
