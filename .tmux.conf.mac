# Mac OS X pasteboard連携
# reattach-to-user-namespace はSierra(10.12)以降不要なので外している
# Ghostty等のモダンターミナル向けに OSC52 でもクリップボードへ書き込む
set -g set-clipboard on

# デフォルトのプレフィックスキーはctrl + bだが、シェルの操作とぶつかるので、ctrl + tに変更する
unbind C-b
set-option -g prefix C-t
bind C-t send-prefix

# コピーモードでvimキーバインドを使う
setw -g mode-keys vi

# Esc単体の待ち時間をなくす
# デフォルト500msはEsc/矢印キーのシーケンス判定用の猶予で、コピーモードの操作が引っかかる
set -sg escape-time 0
# キーリピート中の描画を間引かずに追従させる
set -g repeat-time 300

# コピーモードで大きく飛ぶ
bind-key -T copy-mode-vi C-j send-keys -X -N 5 cursor-down
bind-key -T copy-mode-vi C-k send-keys -X -N 5 cursor-up
bind-key -T copy-mode-vi C-h send-keys -X -N 10 cursor-left
bind-key -T copy-mode-vi C-l send-keys -X -N 10 cursor-right

# 'v' で選択を始める
bind-key -T copy-mode-vi v send-keys -X begin-selection
# LC_ALL=ja_JP.UTF-8 を明示しないと、tmux サーバの LC_CTYPE 未設定状態で
# pbcopy が UTF-8 マルチバイト入力を空書き込み / 途中切りで処理してしまう
# copy-pipe(-and-cancel なし)にすることで、複数箇所コピー時に
# コピーモードを抜けずカーソル位置に留まる。抜けたいときは Enter を使う
bind-key -T copy-mode-vi y send-keys -X copy-pipe "LC_ALL=ja_JP.UTF-8 pbcopy"

# `Enter` でもcopy-pipeを使う
unbind -T copy-mode-vi Enter
bind-key -T copy-mode-vi Enter send-keys -X copy-pipe-and-cancel "LC_ALL=ja_JP.UTF-8 pbcopy"

# マウスドラッグ/ダブルクリック/トリプルクリックでもクリップボードへ
# tmuxデフォルトはコピーパイプ先指定なしでシステムクリップボードへ送られないため明示する
bind-key -T copy-mode-vi MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel "LC_ALL=ja_JP.UTF-8 pbcopy"
bind-key -T copy-mode-vi DoubleClick1Pane \
    select-pane \; send-keys -X select-word \; \
    run-shell -d 0.3 \; send-keys -X copy-pipe-and-cancel "LC_ALL=ja_JP.UTF-8 pbcopy"
bind-key -T copy-mode-vi TripleClick1Pane \
    select-pane \; send-keys -X select-line \; \
    run-shell -d 0.3 \; send-keys -X copy-pipe-and-cancel "LC_ALL=ja_JP.UTF-8 pbcopy"

# ']' でpbpasteを使う
bind ] run "LC_ALL=ja_JP.UTF-8 pbpaste | tmux load-buffer - && tmux paste-buffer"

# 新しいウィンドウ・ペインを現在のディレクトリで開く
bind ^c new-window -c "#{pane_current_path}"
bind '"' split-window -c "#{pane_current_path}"
bind % split-window -h -c "#{pane_current_path}"
unbind ^t
bind ^n next-window
bind ^p previous-window

# bufferの行数を53万にする
set -g history-limit 530000

# マウス操作を有効にする（スクロール、ペイン選択、リサイズ等）
set -g mouse on

# ペイン移動: vimキーバインド
bind h select-pane -L
bind j select-pane -D
bind k select-pane -U
bind l select-pane -R

# ペイン移動: アローキー
bind Left select-pane -L
bind Down select-pane -D
bind Up select-pane -U
bind Right select-pane -R

# ペインリサイズ: vimキーバインド（大文字）
bind -r H resize-pane -L 5
bind -r J resize-pane -D 5
bind -r K resize-pane -U 5
bind -r L resize-pane -R 5

# アクティブペインと非アクティブペインの色分け
# 非アクティブ: テキストも暗くして明確に区別
set -g window-style 'fg=colour245,bg=colour236'
set -g window-active-style 'fg=colour255,bg=terminal'
set -g pane-border-style 'fg=colour238,bg=colour236'
set -g pane-active-border-style 'fg=colour51,bg=terminal'

# Claude Code hook可視化 + ペインごとの枠色をボーダー上部に表示する
# ペイン固有色@pcで「[番号] (🔔アラート or 現在のコマンド名)」を描く
# 非アクティブも色で見分けられ、アクティブペインは太線で強調する
set -g pane-border-status top
set -g pane-border-format '#[fg=#{@pc}]#{?pane_active,━━,──}[#{pane_index}] #{?@pane-alert,🔔 #{@pane-alert},#{pane_current_command}} #{?pane_active,━━━━━━━━━━━━━━━━━━━━,────────────────────}'

# フォーカスが戻ったpaneの🔔マーキングを自動リセットする
set-hook -g after-select-pane[0] 'set-option -p -u @pane-alert'
set-hook -g after-select-pane[1] 'set -w -u window-status-style'
# 選択されたペインの枠線を、そのペイン固有色@pcに塗り替える(非アクティブは共通色のまま)
set-hook -g after-select-pane[2] 'set-window-option pane-active-border-style "fg=#{@pc},bg=terminal"'

# プラグイン管理 (TPM)
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'

# セッション自動保存・自動復元
set -g @continuum-restore 'off'
set -g @continuum-save-interval '15'

# resurrect: ペインの内容も保存
set -g @resurrect-capture-pane-contents 'on'

# 新規ペイン/ウィンドウ作成時に、そのペインへ固有色を自動割り当てする
set-hook -g after-split-window 'run-shell "~/.config/tmux/assign-pane-color.sh #{pane_id}"'
set-hook -g after-new-window 'run-shell "~/.config/tmux/assign-pane-color.sh #{pane_id}"'

# ステータスを2行にし、2行目にアクティブペインのカレントディレクトリ(フルパス)を表示する
set -g status 2
set -g status-format[1] '#[align=left,fg=black] #{pane_current_path}'

# 既存の全ペインへ固有色を一括割り当てする(source-file 時にも振り直す)
run-shell '~/.config/tmux/assign-pane-color.sh'

# TPM初期化（この行は必ず.tmux.confの最後に置く）
run '~/.tmux/plugins/tpm/tpm'
